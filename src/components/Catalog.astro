---
import { cafes } from '../data/cafes';
import CafeCard from './CafeCard.astro';
import DemoNotice from './DemoNotice.astro';
import Filters from './Filters.astro';

/**
 * Static catalog grid (RF-001, RF-002).
 *
 * Every card is pre-rendered into the HTML (progressive enhancement); the
 * shared island only toggles their visibility when filters change.
 */
---

<section id="catalogo" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-12" aria-labelledby="catalogo-title">
  <div class="flex flex-col gap-2">
    <h2 id="catalogo-title" class="font-display text-2xl text-coffee-700 sm:text-3xl">Catálogo</h2>
    <p class="text-coffee-700">
      Explora los cafés de demostración y combina los filtros por región, tueste y proceso.
    </p>
    <DemoNotice />
  </div>

  <Filters />

  <p data-filters-status role="status" aria-live="polite" class="mt-4 text-sm text-coffee-500"></p>

  <ul
    data-catalog
    class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
  >
    {cafes.map((cafe) => (
      <CafeCard cafe={cafe} />
    ))}
  </ul>

  <p
    data-catalog-empty
    hidden
    class="mt-6 rounded-card border border-dashed border-coffee-500/50 p-6 text-center text-coffee-700"
  >
    No encontramos cafés con esos criterios. Prueba con otros filtros o una búsqueda distinta, o pulsa «Limpiar filtros y búsqueda».
  </p>
</section>
